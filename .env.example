# --- Secret source -----------------------------------------------------------
# SECRETS_PROVIDER=env (default): keys are read from this file / the environment
#   directly (fine for local dev).
# SECRETS_PROVIDER=onepassword: any value below that is a 1Password reference
#   (op://vault/item/field) is resolved to its real value at startup using a
#   service-account token read from OP_TOKEN_FILE. Used in the container so no
#   vendor keys ever live in the environment (see docker-compose.yml).
SECRETS_PROVIDER=env
# OP_TOKEN_FILE=/run/secrets/op_token   # only for SECRETS_PROVIDER=onepassword

# AI API Keys (at least one required)
# Local dev: paste real keys. Container: set to op:// references instead.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Council models (all optional, free tiers available)
GEMINI_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# Data providers (free tier keys)
FINNHUB_API_KEY=
GOLDAPI_KEY=
# OPTIONAL. CoinGecko Demo key (coingecko.com/en/api): free, no card, but only
# 10,000 calls/MONTH. Requests are queued and spaced out either way, so keyless
# works fine — the key mainly buys headroom for bursts and fresher data.
COINGECKO_API_KEY=

# Discord bot (optional)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# Discord user IDs allowed to use the bot, comma-separated. STRONGLY RECOMMENDED:
# the chat tools read your positions, change the watchlist and alerts, and spend
# on model calls, so without this anyone who can DM or mention the bot can do all
# three. Get your id: Discord Settings > Advanced > Developer Mode, then
# right-click your name > Copy User ID. Unset = everyone (a warning is logged).
DISCORD_OWNER_IDS=

# REQUIRED for remote MCP access. The container listens on 0.0.0.0, so /mcp is
# reachable from your whole network, and its tools read the portfolio, write to
# the database, and fire the full model council. With this set, every /mcp
# request must send "Authorization: Bearer <token>". Unset = loopback only, so
# remote clients stop working rather than being exposed.
# Generate one: openssl rand -hex 32
MCP_AUTH_TOKEN=

# MCP Server transport (stdio for local, sse/http for Docker)
MCP_TRANSPORT=stdio
MCP_PORT=3100

# SQLite database path
DB_PATH=

# Preferences
DEFAULT_WATCHLIST=BTC,ETH,SPY,SLV
ALERT_COOLDOWN_MINUTES=15

# Daily briefing schedule
BRIEFING_HOUR=8
# Nothing is pushed between these local hours; held items appear in the
# briefing instead. Set both the same to disable.
QUIET_HOURS_START=0
QUIET_HOURS_END=8
BRIEFING_TZ_OFFSET=-4

# Web dashboard access token (min 16 chars). When unset, the dashboard is
# disabled entirely. Open http://<host>:<MCP_PORT>/dashboard?token=YOUR_TOKEN
# once to sign in (sets an HttpOnly cookie). Generate one with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Over plain HTTP (the usual LAN setup) this token crosses the network in clear
# text, so treat it as LAN-only and rotate it if the network is shared.
DASHBOARD_TOKEN=
